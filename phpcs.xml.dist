<?xml version="1.0"?>
<ruleset name="SmoothRestaurant">
    <description>PHPCS ruleset for Smooth Restaurant plugin: PSR-12 base with WordPress-idiomatic seams (hooks, naming, capabilities, nonces, i18n).</description>

    <!-- Base: modern OO style, strict types, typed signatures. -->
    <rule ref="PSR12"/>
    <rule ref="Generic.PHP.RequireStrictTypes"/>

    <!-- WordPress seams only: hook/filter naming, global prefixes,
         capability checks, nonces + input sanitization, i18n. -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals"/>
    <rule ref="WordPress.NamingConventions.ValidHookName"/>
    <rule ref="WordPress.WP.Capabilities"/>
    <rule ref="WordPress.Security.NonceVerification"/>
    <rule ref="WordPress.Security.ValidatedSanitizedInput"/>
    <rule ref="WordPress.WP.I18n"/>

    <!-- Paths to check -->
    <file>src/</file>
    <file>tests/</file>

    <!-- Exclude paths -->
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>node_modules/*</exclude-pattern>
    <exclude-pattern>assets/build/*</exclude-pattern>

    <!-- Compatibility floor: WP 6.8+ / PHP 8.2+. New code may use PHP 8.2 idioms. -->
    <config name="testVersion" value="8.2-"/>

    <!-- Prefixes: SmoothRestaurant\ namespace + smooth_ globals. -->
    <config name="prefixes" value="smooth,SmoothRestaurant"/>

    <!-- Text domain -->
    <config name="text_domain" value="smooth-restaurant"/>

    <!-- tests/bootstrap.php defines WP core constants (WP_TESTS_DIR) that
         cannot carry the plugin prefix; scope the exclusion to that file. -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedConstantFound">
        <exclude-pattern>tests/bootstrap.php</exclude-pattern>
        <!-- RestBootTest defines the WP-core REST_REQUEST constant. -->
        <exclude-pattern>tests/Unit/Providers/RestBootTest.php</exclude-pattern>
    </rule>
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound">
        <exclude-pattern>tests/bootstrap.php</exclude-pattern>
        <!-- BootMatrixTest resets the stub-harness $GLOBALS keys. -->
        <exclude-pattern>tests/Unit/Providers/BootMatrixTest.php</exclude-pattern>
    </rule>

    <!-- tests/Support/WpStubs.php redeclares WP-core API names (add_action,
         apply_filters, is_admin, ...) as lightweight stubs plus the
         $GLOBALS-based stub harness. Prefixing them would defeat the stub. -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <exclude-pattern>tests/Support/WpStubs.php</exclude-pattern>
    </rule>
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>tests/Support/WpStubs.php</exclude-pattern>
        <!-- PHPUnit bootstraps execute by design (autoloader + stubs). -->
        <exclude-pattern>tests/bootstrap.php</exclude-pattern>
        <exclude-pattern>tests/*/bootstrap.php</exclude-pattern>
    </rule>
    <!-- WpStubs redefines WP-core classes (WP_Error, WP_REST_Request, ...) in
         the global namespace with their canonical names; both are required to
         mirror the WordPress API. -->
    <rule ref="PSR1.Classes.ClassDeclaration.MissingNamespace">
        <exclude-pattern>tests/Support/WpStubs.php</exclude-pattern>
    </rule>
    <rule ref="Squiz.Classes.ValidClassName">
        <exclude-pattern>tests/Support/WpStubs.php</exclude-pattern>
    </rule>

    <!-- Tests follow WordPress PHPUnit idiom: snake_case test_* methods and
         doubles colocated with their test (including wpdb-shaped method names
         like get_charset_collate that must mirror the WP API). src/ stays
         strict PSR-12 per the coding-standards spec. -->
    <rule ref="PSR1.Methods.CamelCapsMethodName">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="PSR1.Classes.ClassDeclaration.MultipleClasses">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>

    <!-- Show progress and colors -->
    <arg value="ps"/>
    <arg name="colors"/>

    <!-- Parallel processing -->
    <arg name="parallel" value="8"/>
</ruleset>
